{
  "name": "ai-powered-playwright-real-estate-framework",
  "version": "1.0.0",
  "private": true,
  "description": "Enterprise Playwright and TypeScript automation framework for Propify",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:init": "ts-node scripts/init-db.ts",
    "db:import": "ts-node scripts/import-run-result.ts",
    "evidence:cleanup": "ts-node scripts/cleanup-evidence.ts",
    "start:api": "ts-node server/index.ts",
    "test": "playwright test",
    "test:business": "ts-node scripts/run-business-tests.ts",
    "test:framework": "playwright test --project=framework",
    "test:cross-browser": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:auth": "playwright test tests/authentication --grep-invert \"@external|@mutating\" --workers=2",
    "test:auth:external": "playwright test tests/authentication --grep \"@external|@mutating\" --workers=1",
    "test:auth:mutating": "playwright test --project=mutating-chromium --grep @mutating --workers=1",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report:html": "playwright show-report playwright-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:open": "allure open allure-report"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "26.1.2",
    "allure-commandline": "2.43.0",
    "allure-playwright": "3.10.2",
    "dotenv": "17.4.2",
    "eslint": "10.8.0",
    "googleapis": "174.0.0",
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.66.0",
    "zod": "4.4.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "express": "^5.2.1"
  }
}
