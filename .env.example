TEST_ENV=production
DEV_BASE_URL=https://dev.propifyy.duckdns.org/
STAGING_BASE_URL=https://staging.propifyy.duckdns.org/
PRODUCTION_BASE_URL=https://propifyy.duckdns.org/
API_BASE_URL=https://propifyy.duckdns.org/api
DEFAULT_USER_EMAIL=replace-with-default-user@example.test
DEFAULT_USER_PASSWORD=replace-with-default-user-password
SECONDARY_USER_EMAIL=replace-with-secondary-user@example.test
SECONDARY_USER_PASSWORD=replace-with-secondary-user-password
CI=false
RUN_OTP_E2E=false
RUN_MUTATING_E2E=false
RUN_PRODUCTION_REGISTRATION_E2E=false
RUN_PRODUCTION_MUTATING_E2E=false
GMAIL_CLIENT_ID=replace-with-gmail-client-id
GMAIL_CLIENT_SECRET=replace-with-gmail-client-secret
GMAIL_REFRESH_TOKEN=replace-with-gmail-refresh-token
OTP_MAILBOX_ADDRESS=replace-with-gmail-mailbox@example.test
GMAIL_OTP_SENDER=replace-with-otp-sender@example.test
GMAIL_OTP_SUBJECT=replace-with-exact-otp-subject
GMAIL_OTP_PATTERN=replace-with-exact-otp-text-{otp}
OTP_TIMEOUT_MS=60000
OTP_POLL_INTERVAL_MS=2000
MUTATING_USER_EMAIL=replace-with-mutating-user@example.test
MUTATING_USER_BASELINE_PASSWORD=replace-with-mutating-baseline-password
MUTATING_USER_BASELINE_NAME=replace-with-mutating-baseline-name
ALLOW_MUTATING_E2E=false

# Dữ liệu tin đăng được kiểm soát cho staging/test. Để trống nếu chưa được seed.
LISTING_APPROVED_ID=
LISTING_APPROVED_TITLE=
LISTING_NO_MEDIA_ID=
LISTING_NO_MEDIA_TITLE=
LISTING_UNAPPROVED_ID=
LISTING_UNAPPROVED_TITLE=
LISTING_OWNED_EDITABLE_ID=
LISTING_OWNED_EDITABLE_TITLE=
LISTING_OWNED_PUBLISHED_CANCEL_ID=
LISTING_OWNED_PUBLISHED_CANCEL_TITLE=
LISTING_OWNED_PUBLISHED_WITHDRAW_ID=
LISTING_OWNED_PUBLISHED_WITHDRAW_TITLE=
LISTING_OTHER_OWNER_ID=
LISTING_OTHER_OWNER_TITLE=

# Tin đăng đã xuất bản, có thể reset, thuộc người dùng khác để kiểm thử đặt lịch.
APPOINTMENT_LISTING_ID=
